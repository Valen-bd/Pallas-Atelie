PORT=3000

# ==============================================================================
# CONFIGURAÇÕES DO BANCO DE DADOS (MONGODB) - EXEMPLO
# ==============================================================================
# Insira o usuário e a senha do seu MongoDB:
DB_USER=seu_usuario
DB_PASSWORD=sua_senha_aqui

# Endereço do host (Atlas na nuvem ou local 127.0.0.1):
DB_HOST=cluster0.xxxxxxx.mongodb.net
DB_PORT=27017

# Nome do banco de dados e parâmetros:
DB_NAME=pallas_atelie
DB_OPTIONS=retryWrites=true&w=majority

# Ou utilize a string de conexão direta:
# MONGO_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<DB_HOST>/<DB_NAME>?retryWrites=true&w=majority
